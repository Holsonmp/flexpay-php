<?xml version="1.0"?>
<ruleset name="FlexPay PHP">
    <description>Règles PSR-12 du package FlexPay indépendant.</description>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <file>src</file>
    <file>tests</file>
    <file>tools</file>
    <file>scripts</file>
    <file>bin/flexpay-assets</file>
    <rule ref="PSR12"/>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tools/*.php</exclude-pattern>
    </rule>
</ruleset>
