{
    "name": "holduix/flexpay-php",
    "description": "Client PHP framework-agnostic pour les flux FlexPay",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Holduix"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "Holduix\\FlexPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Holduix\\FlexPay\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/flexpay-assets"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests",
        "style": "phpcs --standard=PSR12 src tests bin/flexpay-assets",
        "coverage": [
            "phpunit --coverage-clover=coverage.xml",
            "@php scripts/check-coverage.php coverage.xml 85"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
